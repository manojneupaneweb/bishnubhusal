<script>
(function() {
const loader = document.getElementById("loader");
if (loader) {
window.addEventListener("load", function() {
setTimeout(() => {
loader.style.opacity = "0";
loader.style.visibility = "hidden";
}, 400);
});
}

function updateActiveNav() {
const sections = ['home', 'about', 'service', 'contact'];
let currentSection = 'home';
const scrollPosition = window.scrollY + 150;

for (let section of sections) {
const element = document.getElementById(section);
if (element) {
const offsetTop = element.offsetTop;
const offsetBottom = offsetTop + element.offsetHeight;
if (scrollPosition >= offsetTop && scrollPosition < offsetBottom) {
currentSection = section;
break;
}
}
}

document.querySelectorAll('.nav-link[data-nav]').forEach(link => {
const navValue = link.getAttribute('data-nav');
if (navValue === currentSection) {
link.classList.add('nav-active');
} else {
link.classList.remove('nav-active');
}
});
}

const navLinks = document.querySelectorAll(".nav-link, .dropdown-menu a");
navLinks.forEach((link) => {
link.addEventListener("click", function(e) {
const targetId = this.getAttribute("href");
if (targetId && targetId.startsWith("#")) {
e.preventDefault();
const targetElement = document.querySelector(targetId);
if (targetElement) {
const offset = 70;
const elementPosition = targetElement.getBoundingClientRect().top + window.pageYOffset;
window.scrollTo({ top: elementPosition - offset, behavior: "smooth" });
const mobileMenu = document.querySelector(".dropdown-menu");
if (mobileMenu && mobileMenu.classList.contains("menu-open")) {
mobileMenu.classList.remove("menu-open");
}
setTimeout(() => updateActiveNav(), 100);
}
}
});
});

const dropdownToggle = document.querySelector(".dropdown label");
if (dropdownToggle) {
dropdownToggle.addEventListener("click", function(e) {
const menuPanel = document.querySelector(".dropdown-menu");
if (menuPanel) {
menuPanel.classList.toggle("menu-open");
}
});
}

window.addEventListener("scroll", function() {
const navbar = document.getElementById("navbar");
if (window.scrollY > 20) {
navbar.classList.add("shadow-lg", "bg-white/95");
navbar.classList.remove("bg-white");
} else {
navbar.classList.add("bg-white");
navbar.classList.remove("bg-white/95");
}
updateActiveNav();
});

window.addEventListener('load', function() {
updateActiveNav();
});

const style = document.createElement("style");
style.textContent = `
.dropdown-menu.menu-open { display: block !important; }
.dropdown-menu:not(.menu-open) { display: none; }
@media (max-width: 1024px) {
.dropdown-menu { display: none; position: absolute; right: 0; background: white; border-radius: 1rem; box-shadow: 0 20px 30px -10px rgba(0,0,0,0.1); }
}
.scroll-mt-20 { scroll-margin-top: 80px; }
`;
document.head.appendChild(style);
const mediaImg = document.querySelector('img[alt="Sachetana Media"]');
if (mediaImg && mediaImg.complete && mediaImg.naturalWidth === 0) {
mediaImg.src = "https://placehold.co/200x200?text=Sachetana+Media";
}
})();
</script>
